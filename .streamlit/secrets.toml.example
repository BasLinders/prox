# Template for .streamlit/secrets.toml, which is gitignored and not part of
# this repo. Copy this file to secrets.toml and fill in the real values --
# see docs/dev_roadmap.md's "BigQuery live data source" section for context.
#
# Streamlit loads .streamlit/secrets.toml automatically into st.secrets;
# nothing else needs to point at this file.

[bigquery]
# OAuth 2.0 client, created in Google Cloud Console under
# "APIs & Services > Credentials" (type: Web application). Scope the client
# to bigquery.readonly / cloud-platform.read-only only -- PRoX never writes
# to BigQuery. Passed to foe.data.DataEngine.build_auth_url/exchange_code.
client_id = "your-oauth-client-id.apps.googleusercontent.com"
client_secret = "your-oauth-client-secret"

# Must exactly match a redirect URI registered on the OAuth client above.
# For local development this is typically the Streamlit app's own URL.
redirect_uri = "http://localhost:8501"

# Default BigQuery project/dataset for the GA4 export this deployment reads
# from (foe.core.models.BQConnectionConfig). Used to prefill the
# project/dataset picker -- the user can still pick a different project via
# DataEngine.list_projects()/list_datasets() once authenticated.
project = "your-gcp-project-id"
dataset = "analytics_123456789"
# Optional -- BigQuery job location (e.g. "EU", "US"). Auto-detected from
# the dataset when left blank.
location = ""
